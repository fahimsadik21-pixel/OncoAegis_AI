# Copy to .env or set these in the deployment environment. Never commit real values.
ONCOAEGIS_JWT_SECRET_KEY=replace-with-a-long-random-secret
ONCOAEGIS_AUTH_DATABASE_PATH=outputs/auth.sqlite3

# Google OAuth
ONCOAEGIS_GOOGLE_CLIENT_ID=
ONCOAEGIS_GOOGLE_CLIENT_SECRET=
ONCOAEGIS_GOOGLE_REDIRECT_URI=https://your-domain.example/auth/oauth/google/callback

# Apple OAuth
ONCOAEGIS_APPLE_CLIENT_ID=
ONCOAEGIS_APPLE_CLIENT_SECRET=
ONCOAEGIS_APPLE_TEAM_ID=
ONCOAEGIS_APPLE_KEY_ID=
ONCOAEGIS_APPLE_PRIVATE_KEY_PATH=
ONCOAEGIS_APPLE_REDIRECT_URI=https://your-domain.example/auth/oauth/apple/callback

# Optional natural-language cancer-information provider.
# Leave the key empty to use the built-in safe educational fallback.
ONCOAEGIS_CANCER_AI_API_KEY=
ONCOAEGIS_CANCER_AI_BASE_URL=https://api.openai.com/v1
ONCOAEGIS_CANCER_AI_MODEL=gpt-4o-mini

{
  "rewrites": [
    { "source": "/app/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/app", "destination": "/" },
    { "source": "/auth/:path*", "destination": "https://oncoaegisai-production.up.railway.app/auth/:path*" },
    { "source": "/chat/:path*", "destination": "https://oncoaegisai-production.up.railway.app/chat/:path*" },
    { "source": "/analyze/:path*", "destination": "https://oncoaegisai-production.up.railway.app/analyze/:path*" },
    { "source": "/information/:path*", "destination": "https://oncoaegisai-production.up.railway.app/information/:path*" },
    { "source": "/cases/:path*", "destination": "https://oncoaegisai-production.up.railway.app/cases/:path*" },
    { "source": "/storage/:path*", "destination": "https://oncoaegisai-production.up.railway.app/storage/:path*" },
    { "source": "/capabilities", "destination": "https://oncoaegisai-production.up.railway.app/capabilities" },
    { "source": "/datasets", "destination": "https://oncoaegisai-production.up.railway.app/datasets" },
    { "source": "/models", "destination": "https://oncoaegisai-production.up.railway.app/models" },
    { "source": "/cancer-capabilities", "destination": "https://oncoaegisai-production.up.railway.app/cancer-capabilities" },
    { "source": "/health", "destination": "https://oncoaegisai-production.up.railway.app/health" },
    { "source": "/system/status", "destination": "https://oncoaegisai-production.up.railway.app/system/status" }
  ]
}
